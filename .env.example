# Variables del servidor. Configurarlas en el proyecto de Vercel de la API; nunca versionar valores.
# Las vacías cuentan como no definidas. Valores por defecto y validación: birdnet_api/settings.py (resumen en el README).
# Cadena del Transaction pooler de Supabase (puerto 6543).
DATABASE_URL=
# Segundos de espera al conectar con la base de datos (entero, opcional).
DATABASE_CONNECT_TIMEOUT_SECONDS=
# https://<proyecto>.supabase.co/auth/v1
SUPABASE_AUTH_ISSUER=
# Solo para tokens HS256 heredados; los proyectos nuevos usan claves asimétricas (JWKS).
SUPABASE_JWT_SECRET=
# Segundos de espera al descargar las claves públicas (JWKS) del emisor (opcional).
JWKS_TIMEOUT_SECONDS=
# Storage con la clave de servicio: fotos de perfil y grabaciones guardadas (opcional).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado de las fotos de perfil (opcional; por defecto avatars, creado por la migración).
SUPABASE_AVATAR_BUCKET=
# Bucket privado de las grabaciones guardadas (opcional; por defecto recordings, creado por la migración).
SUPABASE_RECORDING_BUCKET=
# Tope de grabaciones por cuenta en bytes (opcional; por defecto 52428800, 50 MiB).
RECORDING_QUOTA_BYTES=
# Tope de caminatas guardadas por cuenta (opcional; por defecto 200).
WALK_QUOTA=
# Segundos de espera de cada petición a Storage (opcional).
STORAGE_TIMEOUT_SECONDS=
# Modelo de lenguaje que redacta fichas e informes (ADR-37). Clave de Google AI Studio, plan gratuito sin facturación.
GEMINI_API_KEY=
# Modelo y dirección de la API (opcionales; por defecto gemini-3.5-flash-lite y https://generativelanguage.googleapis.com/v1beta).
GEMINI_MODEL=
GEMINI_API_URL=
# Textos nuevos por persona y por día, y en total por día (opcionales; por defecto 10 y 200). El total debe quedar por debajo del límite diario que muestra AI Studio.
LLM_USER_DAILY_QUOTA=
LLM_DAILY_QUOTA=
# Segundos de espera del modelo y de Wikipedia/GBIF, y días tras los que se reescribe una ficha (opcionales; 20, 6 y 180).
LLM_TIMEOUT_SECONDS=
PUBLIC_DATA_TIMEOUT_SECONDS=
SPECIES_CARD_MAX_AGE_DAYS=
# Cantos de referencia de xeno-canto (ADR-42): clave de una cuenta con correo verificado (página de la cuenta en xeno-canto).
XENO_CANTO_API_KEY=
# Dirección de la API v3 y días que la CDN de Vercel guarda la respuesta de cada especie (opcionales; https://xeno-canto.org/api/3 y 7).
XENO_CANTO_API_URL=
SOUNDS_CACHE_DAYS=
# Errores de la API en Sentry (ADR-43): DSN del proyecto de Sentry (opcional; sin él no se envía nada).
SENTRY_DSN=
# Modelo acústico servido desde Supabase Storage.
MODEL_MANIFEST_PATH=
MODEL_MANIFEST_URL=
MODEL_RESOURCE_BASE_URL=
# Hosts permitidos para MODEL_MANIFEST_URL, separados por comas, sin esquema ni puerto (opcional; por defecto, el host de SUPABASE_URL o, si falta, el de MODEL_MANIFEST_URL).
MODEL_MANIFEST_ALLOWED_HOSTS=
# Segundos de espera y tamaño máximo en bytes del manifiesto remoto (opcionales).
MODEL_MANIFEST_TIMEOUT_SECONDS=
MAX_MANIFEST_BYTES=
# Límites de las peticiones y respuestas (opcionales).
MAX_METADATA_BODY_BYTES=
MAP_RESULT_LIMIT=
EXPORT_ROW_LIMIT=
# Zona horaria IANA de las estadísticas cuando el cliente no envía una (opcional).
DEFAULT_TIME_ZONE=
